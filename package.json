{
  "name": "minecraft-agent-skills",
  "private": true,
  "version": "2.5.2",
  "type": "module",
  "scripts": {
    "audit:skills": "node ./scripts/audit-skills.mjs",
    "test:validators": "node ./scripts/run-bash.mjs ./scripts/run-skill-validator-fixtures.sh",
    "test:repo-policy": "node ./scripts/run-bash.mjs ./scripts/test-repo-policy-fixtures.sh",
    "test:docs": "node ./scripts/validate-doc-snippets.mjs",
    "check:plugin-bundle": "node ./scripts/validate-plugin-bundle.mjs",
    "sync:skills": "node ./scripts/sync-skills-layout.mjs sync",
    "check:sync": "node ./scripts/sync-skills-layout.mjs check",
    "check:version-drift": "node ./scripts/check-version-drift.mjs",
    "check:workflow-pins": "node ./scripts/check-workflow-action-pins.mjs",
    "lint:md": "markdownlint-cli2 \"*.md\" \".agents/**/*.md\" \".codex/**/*.md\" \".claude/**/*.md\" \"plugins/**/*.md\" \"tests/**/*.md\"",
    "check": "npm run check:sync && npm run check:plugin-bundle && npm run audit:skills && npm run check:version-drift && npm run test:docs && npm run test:validators && npm run test:repo-policy && npm run check:workflow-pins && npm run lint:md"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "picomatch": "2.3.2",
    "js-yaml": "5.4.0"
  },
  "devDependencies": {
    "js-yaml": "5.4.0",
    "markdownlint-cli2": "0.23.2"
  }
}
